<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors>$(WarningsAsErrors);FS0025</WarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Sample.fs" />
    <Compile Include="ModelTests.fs" />
    <Compile Include="RulesTests.fs" />
    <Compile Include="PipelineTests.fs" />
    <Compile Include="DriftTests.fs" />
    <Compile Include="WireTests.fs" />
    <Compile Include="CorpusTests.fs" />
    <Compile Include="ConformanceTests.fs" />
    <Compile Include="BoundaryTests.fs" />
    <Compile Include="ReferenceDialect.fs" />
    <Compile Include="ProviderTests.fs" />
    <Compile Include="PolicyTests.fs" />
    <Compile Include="ProjectionTests.fs" />
    <Compile Include="FingerprintTests.fs" />
    <Compile Include="SubstraitSurveyTests.fs" />
    <Compile Include="SqlServerTests.fs" />
    <Compile Include="PostgreSqlTests.fs" />
    <Compile Include="SessionTests.fs" />
    <Compile Include="FieldTests.fs" />
    <Compile Include="Main.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="10.1.300" />
    <PackageReference Include="Expecto" Version="10.2.3" />
    <PackageReference Include="Fuaran.Core.Conformance" Version="0.37.0" />
    <!-- The engine-backed conformance leg's host only (Phase 1901); no package of this repository references a driver. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <!-- The PostgreSQL engine-backed leg's host only (Phase 1906), as above. -->
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <!-- Lifts SqlClient's transitive System.Security.Cryptography.Pkcs 9.0.13 past GHSA-2fmv-rv2c-59x7 and
         GHSA-846f-f764-76mx, which the restore's audit reports as errors. Test host only. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Fuaran.DB\Fuaran.DB.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.DB.Provider\Fuaran.DB.Provider.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.DB.Dialect.SqlServer\Fuaran.DB.Dialect.SqlServer.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.DB.Conformance\Fuaran.DB.Conformance.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.DB.Session\Fuaran.DB.Session.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.DB.Dialect.PostgreSql\Fuaran.DB.Dialect.PostgreSql.fsproj" />
  </ItemGroup>

</Project>
