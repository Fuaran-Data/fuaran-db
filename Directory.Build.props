<Project>
  <PropertyGroup>
    <!-- The one version every package in this repository is cut at, read by pack.ps1's same-version
         guard. STABILITY.md says whether the standing number is a draft slot or a released one. -->
    <Version>0.2.0</Version>
    <Authors>Andrew J. Willshire</Authors>
    <Company>Diametrical Ltd</Company>
    <Copyright>Copyright 2026 Diametrical Ltd</Copyright>
    <!-- Apache-2.0, decided 2026-10-11 (DECISIONS D3). The repository was written to a public standard
         from its first commit so that choosing a licence would be a one-line act; this is that line. -->
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Fuaran-Data/fuaran-db</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Fuaran-Data/fuaran-db</PackageProjectUrl>
  </PropertyGroup>
  <PropertyGroup>
    <!-- One version property per producing repository (DECISIONS D14). Each names a version that is
         tagged and served by nuget.org, never a <Version> read from a clone: this repository restores
         from the public feed alone, and so does every consumer of its packages. The pair is the newest
         published line; a consumer raises to it, so a module consuming them and this repository restores one Core and
         one Compute. -->
    <FuaranCoreVersion>0.42.0</FuaranCoreVersion>
    <FuaranComputeVersion>0.44.0</FuaranComputeVersion>
  </PropertyGroup>
</Project>
