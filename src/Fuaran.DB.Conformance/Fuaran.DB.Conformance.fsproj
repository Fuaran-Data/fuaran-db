<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors>$(WarningsAsErrors);FS0025</WarningsAsErrors>
    <WarnOn>3390;$(WarnOn)</WarnOn>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Fuaran.DB.Conformance</PackageId>
    <Description>Fuaran.DB.Conformance — the parity kit a dialect is certified with: a seed schema and seed rows, stated fixture pipelines with the reference evaluator's expected results, the differences each fixture may show by name, and a runner that takes the HOST'S executor as a function and reports each fixture as agreed, differing as pinned, or differing unexpectedly. References no database driver and opens no connection.</Description>
    <RepositoryUrl>https://github.com/Fuaran-Data/fuaran-db</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Fixtures.fs" />
    <Compile Include="Kit.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="10.1.300" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fuaran.DB.Provider\Fuaran.DB.Provider.fsproj" />
  </ItemGroup>

</Project>
