<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- An incomplete match is an error: the closed unions here (and the transform algebra this
         package walks) are matched with no catch-all, so a new case stops the build at every arm
         that must decide it. -->
    <WarningsAsErrors>$(WarningsAsErrors);FS0025</WarningsAsErrors>
    <WarnOn>3390;$(WarnOn)</WarnOn>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Fuaran.DB</PackageId>
    <Description>Fuaran.DB — the dataset model: a typed, default-deny tree of what a data source holds and what may be asked of it (sources, tables, columns with a type and a classification, permitted joins, measures, row policies and limits), with its op vocabulary, named validators, a check of a transform pipeline against the model, seeding and drift against a reported schema, a canonical wire codec and an AI-tools surface. Opens no connection. FSharp.Core and Fuaran.Core packages only.</Description>
    <RepositoryUrl>https://github.com/Fuaran-Data/fuaran-db</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Model.fs" />
    <Compile Include="Fingerprint.fs" />
    <Compile Include="Exprs.fs" />
    <Compile Include="Rules.fs" />
    <Compile Include="Pipeline.fs" />
    <Compile Include="Policy.fs" />
    <Compile Include="Drift.fs" />
    <Compile Include="Wire.fs" />
    <Compile Include="ModelProjection.fs" />
    <Compile Include="AiTools.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Released versions, resolvable from the public feed alone (DECISIONS.md D3). -->
    <PackageReference Update="FSharp.Core" Version="10.1.300" />
    <PackageReference Include="Fuaran.Core.Tree" Version="0.42.0" />
    <PackageReference Include="Fuaran.Core.Ops" Version="0.42.0" />
    <PackageReference Include="Fuaran.Core.OpStream" Version="0.42.0" />
    <PackageReference Include="Fuaran.Core.Validator" Version="0.42.0" />
    <PackageReference Include="Fuaran.Core.Wire" Version="0.42.0" />
    <PackageReference Include="Fuaran.Core.Column" Version="0.42.0" />
    <PackageReference Include="Fuaran.Core.AiSurface" Version="0.42.0" />
    <PackageReference Include="Fuaran.Core.Conformance" Version="0.42.0" />
    <PackageReference Include="Fuaran.Compute.DataFrame" Version="0.44.0" />
  </ItemGroup>

</Project>
